{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "react"],
    "paths": {
      "@shared/*": ["./packages/shared/src/*"]
    }
  },
  "include": ["packages/**/*.ts", "extensions/**/*.ts", "extensions/**/*.tsx", "scripts/**/*.mjs"]
}
